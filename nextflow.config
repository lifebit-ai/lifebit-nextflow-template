/*
========================================================================================
    lifebit-nextflow-template: main configuration
========================================================================================
*/

manifest {
    name            = 'lifebit-nextflow-template'
    description     = 'Template for building modular Nextflow DSL2 pipelines'
    homePage        = 'https://github.com/lifebit-ai/lifebit-nextflow-template'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version         = '1.0.0'
    license         = 'Apache-2.0'
}

// Default values of all the pipeline parameters. Every parameter must be declared here,
// or in the config file that uses them (e.g. the azure_* params in conf/azurebatch.config).
params {
    input  = null
    outdir = 'results'
    help   = false

    // Executor used by the job, set automatically by CloudOS (see conf/cloud-provider.config)
    lifebit_platform_executor = 'local'
}

includeConfig 'conf/base.config'            // compute resources and error strategy
includeConfig 'conf/containers.config'      // container image of each process
includeConfig 'conf/cloud-provider.config'  // executor-specific settings (e.g. Azure Batch pools)

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test      { includeConfig 'conf/test.config' }
    test_full { includeConfig 'conf/test_full.config' }
}

// Execution reports, written to <outdir>/pipeline_info
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,status,exit,container,cpus,memory,time,realtime,%cpu,peak_rss,peak_vmem'
}
