/*
    Compute resources.

    Processes request resources through a label (process_low / process_medium / process_high)
    instead of hard-coding them, so they can be tuned here in one place.

    Tasks killed by the system (e.g. out of memory or spot instance reclaimed) are retried
    up to twice, with more memory on each attempt.
*/
process {
    cpus   = 1
    memory = 2.GB
    time   = 4.h

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: process_high {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
}
