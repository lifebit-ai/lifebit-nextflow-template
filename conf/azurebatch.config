/*
    Azure Batch settings, included by conf/cloud-provider.config.

    Each resource label runs on its own pool, with a VM size large enough for the label's
    resources (see conf/base.config). VM sizes and prices:
    https://azure.microsoft.com/en-gb/pricing/details/batch/

    Rename the pools with the name of your pipeline: pools are shared by all the pipelines
    of a Batch account, so pipelines needing different VM sizes must not reuse the same names.

    Every process must have a resource label: a process without a label gets no queue and
    falls back to a pool created automatically by Nextflow.
*/
params {
    azure_vm_type_low    = 'Standard_D2s_v3'   //  2 vCPU,  8 GB
    azure_vm_type_medium = 'Standard_D4s_v3'   //  4 vCPU, 16 GB
    azure_vm_type_high   = 'Standard_E8s_v3'   //  8 vCPU, 64 GB
    azure_max_vm_count   = 50
    azure_disk_size      = '500 GB'
    azure_spot           = false
}

azure {
    batch {
        allowPoolCreation       = true
        deletePoolsOnCompletion = true
        copyToolInstallMode     = 'task'
        pools {
            lifebit_nextflow_template_low {
                vmType     = params.azure_vm_type_low
                autoScale  = true
                vmCount    = 1
                maxVmCount = params.azure_max_vm_count
                diskSize   = params.azure_disk_size
                spot       = params.azure_spot
                privileged = true   // run tasks with elevated (admin) permissions on the node
            }
            lifebit_nextflow_template_medium {
                vmType     = params.azure_vm_type_medium
                autoScale  = true
                vmCount    = 1
                maxVmCount = params.azure_max_vm_count
                diskSize   = params.azure_disk_size
                spot       = params.azure_spot
                privileged = true   // run tasks with elevated (admin) permissions on the node
            }
            lifebit_nextflow_template_high {
                vmType     = params.azure_vm_type_high
                autoScale  = true
                vmCount    = 1
                maxVmCount = params.azure_max_vm_count
                diskSize   = params.azure_disk_size
                spot       = params.azure_spot
                privileged = true   // run tasks with elevated (admin) permissions on the node
            }
        }
    }
}

/*
    VM sizes are fixed, so retrying with more memory would exceed the VM:
    on Azure, tasks keep the label's memory and are only retried when the VM is reclaimed.
*/
process {
    errorStrategy = { task.exitStatus in [104, 134, 139, 143] ? 'retry' : 'finish' }

    withLabel: process_low {
        queue  = 'lifebit_nextflow_template_low'
        memory = 2.GB
    }
    withLabel: process_medium {
        queue  = 'lifebit_nextflow_template_medium'
        memory = 8.GB
    }
    withLabel: process_high {
        queue  = 'lifebit_nextflow_template_high'
        memory = 32.GB
    }
}
