/*
    Minimal test: 2 samples.

    The test data is shipped inside the repository (testdata/), so this profile does not
    need access to any external bucket or website and runs in any environment:
    locally, AWS, Azure, with or without a firewall.

        nextflow run main.nf -profile test,docker
*/
params {
    input = "${projectDir}/testdata/samplesheet_test.csv"
}
